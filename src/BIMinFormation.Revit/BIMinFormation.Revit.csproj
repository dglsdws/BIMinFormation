<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Add-in do Revit, uma compilação por versão: dotnet build -p:RevitVersion=2023|2025|2026|2027 (padrão 2023).
    2023: .NET Framework 4.8; 2025 e 2026: .NET 8; 2027: .NET 10.
  -->
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitVersion)' == '2023'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>BIMinFormation.Revit</RootNamespace>
    <AssemblyName>BIMinFormation.Revit</AssemblyName>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' != '2023'">$(DefineConstants);REVIT2025_OR_GREATER</DefineConstants>
    <DefineConstants Condition="'$(RevitVersion)' == '2026' Or '$(RevitVersion)' == '2027'">$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RevitVersion)' != '2023'">
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Só referência: em execução quem fornece RevitAPI.dll é o próprio Revit. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(RevitVersion)' == '2023'">
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BIMinFormation.Ids\BIMinFormation.Ids.csproj" />
    <ProjectReference Include="..\BIMinFormation.Core\BIMinFormation.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BIMinFormation.Revit.Harness" />
  </ItemGroup>

  <ItemGroup>
    <None Include="BIMinFormation.addin" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="BIMinFormation.Revit.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
